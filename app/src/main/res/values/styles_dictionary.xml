<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DictionaryAction" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primaryText</item>
    </style>
    <style name="DictionaryIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/primaryText</item>
    </style>
    <style name="DictionaryHeading">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/primaryText</item>
    </style>
    <style name="DictionaryDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#252522</item>
        <item name="android:colorBackground">#FAF9F6</item>
    </style>
    <style name="DictionaryDialogTheme.Night" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#E5E3DF</item>
        <item name="android:colorBackground">#202020</item>
    </style>
</resources>
