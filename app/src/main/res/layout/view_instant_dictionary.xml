<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/instant_dictionary_card" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_margin="12dp"
    android:padding="10dp" android:orientation="vertical" android:background="@color/background_menu"
    android:elevation="8dp" android:visibility="gone">
    <TextView android:id="@+id/instant_dictionary_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/primaryText" android:textSize="16sp"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/instant_dictionary_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/primaryText" android:textSize="16sp"
        android:maxLines="5" android:ellipsize="end" android:paddingTop="6dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/instant_dictionary_language" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/dictionary_query_language" />
        <Button android:id="@+id/instant_dictionary_full" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/dictionary_full_entry" />
        <Button android:id="@+id/instant_dictionary_close" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/close" />
    </LinearLayout>
</LinearLayout>
