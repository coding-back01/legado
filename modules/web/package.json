{
  "name": "legado-web",
  "version": "1.0.0",
  "private": true,
  "description": "coding-back01/legado 内置网页端",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coding-back01/legado.git",
    "directory": "modules/web"
  },
  "bugs": {
    "url": "https://github.com/coding-back01/legado/issues"
  },
  "homepage": "https://github.com/coding-back01/legado#readme",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" -- && node ./scripts/sync.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test:chapter-html": "tsc --strict --noEmitOnError --pretty false --rootDir . --target ES2022 --module NodeNext --moduleResolution NodeNext --types node --outDir node_modules/.tmp/chapter-html-test src/utils/chapterHtml.ts tests/chapterHtml.test.ts && node node_modules/.tmp/chapter-html-test/tests/chapterHtml.test.js",
    "test:static-links": "node --test tests/staticLinks.test.mjs && node scripts/check-static-links.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@element-plus/icons-svg": "^2.3.1",
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/shared": "^14.4.0",
    "axios": "^1.20.0",
    "element-plus": "2.14.5",
    "hotkeys-js": "^4.0.7",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "vue3-virtual-scroll-list": "^0.2.1"
  },
  "devDependencies": {
    "sass-embedded": "^1.83.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.16.11",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.12.0",
    "eslint-plugin-vue": "^9.29.0",
    "npm-run-all2": "^6.2.3",
    "prettier": "^3.3.3",
    "typescript": "~5.5.4",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-icons": "^0.19.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^6.4.3",
    "vue-tsc": "^2.1.6"
  }
}
