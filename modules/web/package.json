{
  "name": "legado-web",
  "version": "1.0.0",
  "private": true,
  "description": "coding-back01/legado 内置网页端",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coding-back01/legado.git",
    "directory": "modules/web"
  },
  "bugs": {
    "url": "https://github.com/coding-back01/legado/issues"
  },
  "homepage": "https://github.com/coding-back01/legado#readme",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" -- && node ./scripts/sync.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test:chapter-html": "tsc --project tsconfig.chapter-test.json && node node_modules/.tmp/chapter-html-test/tests/chapterHtml.test.js",
    "test:static-links": "node --test tests/staticLinks.test.mjs && node scripts/check-static-links.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@element-plus/icons-svg": "^2.3.1",
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/shared": "^15.0.0",
    "axios": "^1.20.0",
    "element-plus": "2.14.5",
    "hotkeys-js": "^4.0.8",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue3-virtual-scroll-list": "^0.2.1"
  },
  "devDependencies": {
    "sass-embedded": "^1.83.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
